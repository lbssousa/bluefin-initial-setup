# 70-keepassxc-yubikey-lock.rules — trava o KeePassXC quando a YubiKey é
# removida. Instalado por playbooks/keepassxc.yml (Ansible), a partir de
# keepassxc-yubikey-lock.rules.j2 — NÃO EDITE À MÃO, reescrito a cada
# execução do playbook. Portado de lbssousa/nix-config
# (modules/system/security/keepassxc-yubikey-lock.nix).
#
# ENV{PRODUCT}=="1050/*" casa qualquer modelo de YubiKey (vendor Yubico
# 1050), não só o produto específico do nix-config original (1050/407)
# — desvio proposital para cobrir qualquer YubiKey que o usuário
# conecte. Em eventos "remove" os atributos derivados (ID_VENDOR_ID
# etc.) costumam não estar mais disponíveis; só o campo bruto PRODUCT é
# confiável nesse ponto (mesma técnica usada por
# /usr/lib/udev/rules.d/39-usbmuxd.rules neste sistema).
ACTION=="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{PRODUCT}=="1050/*", RUN+="/usr/bin/systemd-run --no-block --quiet --collect --service-type=oneshot {{ keepassxc_yubikey_lock_script_dest }} {{ ansible_facts.env.USER }}"
